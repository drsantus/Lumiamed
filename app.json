{
  "expo": {
    "name": "LumiaMed",
    "slug": "lumiamed",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lumiamed",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.lumiamed",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "it"
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "app.lumiamed"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
